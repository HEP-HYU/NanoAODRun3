# NanoAODRun3 — git ignore rules
# Physics source code and config files ARE tracked.
# Build artifacts, analysis outputs, and temp files are NOT tracked.

CMSSW*
plotIt

# ── C++ build artifacts ────────────────────────────────────────────
*.o
*.so
*.d
# ROOT dictionary generated files (recreated by rootcint during make)
rootdict*.C
rootdict*_rdict.pcm
JetMETObjects_dict*.C
JetMETObjects_dict*_rdict.pcm
*_dictContent.h
*_dictUmbrella.h
*.C_tmp_*

# ── Python cache ───────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── ROOT analysis output ───────────────────────────────────────────
# Processed histograms and skimmed NanoAODs are stored separately
*.root
*/process_*

# ── DNN training artifacts ─────────────────────────────────────────
*.h5
*.keras
*.pkl
scaler_*.pickle
feature_importance.csv
dnn_model/
training_history/
DNN/DNN_*

# ── Editor / OS temp files ─────────────────────────────────────────
*.swp
*~
.DS_Store
.vscode/
.idea/
ttHH*

# ── SLURM job logs ─────────────────────────────────────────────────
slurm-*.out
slurm_output/
*.log

# ── Plotting output ────────────────────────────────────────────────
*.pdf
*.png
